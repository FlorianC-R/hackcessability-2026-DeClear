# DeClear environment variables (EXAMPLE — copy to .env.local and fill in).
#
# These are SERVER-SIDE ONLY. They are read by the serverless route
# api/explain.js via process.env. Do NOT prefix them with VITE_, or Vite would
# bundle them into the browser and leak the key.
#
# .env.local is gitignored (matched by "*.local"), so your real key is never
# committed. Never paste the real key into any committed file.

# Your Google Gemini API key from Google AI Studio (free tier; no billing).
GEMINI_API_KEY=your-gemini-api-key-here

# The EXACT free-tier Gemini model id shown as available in your Google AI
# Studio account (verify with the ListModels API / the AI Studio model list).
# Example placeholder only — replace with the real id you verified:
GEMINI_MODEL=gemini-flash-model-id-you-verified
